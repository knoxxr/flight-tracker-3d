# Server configuration
PORT=3000
HOST=0.0.0.0

# Optional OpenSky Network OAuth2 credentials (FREE account — unlocks single-request global ~10,000+ live flights including oceans/rural areas)
# Sign up at https://opensky-network.org/ -> Account -> Create API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Legacy OpenSky Basic Auth (accounts created before March 2025)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Optional FlyItalyADSB global feed (Pro plan returns ~11,000 global flights in one request)
FLYITALY_API_KEY=
FLYITALY_GLOBAL=false

# Live API polling interval in milliseconds
OPENSKY_POLL_INTERVAL_MS=20000

# Maximum simultaneous real-time aircraft displayed on the 3D globe (15000 = effectively uncapped)
MAX_FLIGHTS=15000
