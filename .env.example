# Server configuration
PORT=3000
HOST=0.0.0.0

# Optional OpenSky Network credentials (recommended for higher rate limits)
# See: https://openskynetwork.github.io/opensky-api/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Optional OpenSky OAuth2 client credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Live API polling interval in milliseconds (minimum 10000 for anonymous OpenSky)
OPENSKY_POLL_INTERVAL_MS=20000

# Maximum real-time aircraft displayed simultaneously on the 3D globe
MAX_FLIGHTS=1500
