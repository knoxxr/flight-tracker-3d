# Server configuration
PORT=3000
HOST=0.0.0.0

# Flight data source mode: auto | live | simulation
# - auto: Try live OpenSky Network ADS-B feed, fall back smoothly to realistic global simulation if rate-limited or offline
# - live: Require live OpenSky Network ADS-B data
# - simulation: Always run the built-in global great-circle flight physics simulator
FLIGHT_DATA_MODE=auto

# Optional OpenSky Network credentials (recommended for higher rate limits)
# See: https://openskynetwork.github.io/opensky-api/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Optional OpenSky OAuth2 client credentials
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Live API polling interval in milliseconds (minimum 10000 for anonymous OpenSky)
OPENSKY_POLL_INTERVAL_MS=15000

# Maximum aircraft returned per response to keep 3D globe silky smooth
MAX_FLIGHTS=600
